NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/school_management

# JWT Secrets (MUST change in production - use strong random strings)
JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production

# Token Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Client URL (frontend origin for CORS)
CLIENT_URL=http://localhost:3000

# School Information
SCHOOL_NAME=School Management System
SCHOOL_ADDRESS=123 Education Street, City, State 12345
SCHOOL_PHONE=+1 (555) 123-4567
SCHOOL_EMAIL=info@school.edu

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Initial Admin Credentials (for seed-dev script)
INITIAL_ADMIN_EMAIL=admin@school.gs
INITIAL_ADMIN_PASSWORD=admin123
